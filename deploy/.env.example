# Copy to deploy/.env on the VPS ONLY. Never commit actual values.
# Choose your own domain (hostname only); frontend and API share this origin.
SATORNA_DOMAIN=satorna.example.org
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
VELLA_AUTH_SECRET=
OPENAI_API_KEY=
VELLA_OPENAI_REVIEW_MODEL=gpt-4o-mini
VELLA_WB_LIVE_SYNC_ENABLED=false
VELLA_REPRICER_WB_SYNC_ENABLED=true
VELLA_REPRICER_SCHEDULER_ENABLED=false
VELLA_REAL_PRICE_APPLY_ENABLED=false
VELLA_REPRICER_LOCAL_PRICE_APPLY_ENABLED=false
VELLA_AVITO_REPRICER_PRICE_APPLY_ENABLED=false
VELLA_WB_FEEDBACKS_SEND_ENABLED=false
VELLA_AVITO_RETURNS_SYNC_ENABLED=true
# Optional provider-wide credentials; per-organization connections are entered
# through the application after registering in the NEW production database.
VELLA_WB_API_TOKEN=
VELLA_WB_CONTENT_API_TOKEN=
VELLA_WB_STATISTICS_API_TOKEN=
VELLA_WB_ADS_API_TOKEN=
VELLA_SPP_API_TOKEN=
